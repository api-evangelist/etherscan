                  "description": "(Required) Numeric chain ID (e.g. 1 for Ethereum mainnet, 56 for BNB Smart Chain, 8453 for Base)."
                },
                {
                  "disabled": false,
                  "key": "module",
                  "value": "<string>",
                  "description": "(Required) API module (account, contract, transaction, block, stats, gastracker, token)."
                },
                {
                  "disabled": false,
                  "key": "action",
